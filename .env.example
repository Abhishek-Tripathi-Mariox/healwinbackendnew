# ============================================================================
#  HealWin — backend environment
#
#  Copy to .env and fill in. Values here are PLACEHOLDERS, never real secrets:
#
#      cp .env.example .env
#
#  The seven variables under "Required" must be set or the server refuses to
#  boot (config/index.ts throws). Everything else has a working default, shown
#  as the value after the "=" — you only need to set it to change it.
#
#  Never commit a filled-in .env.
# ============================================================================


# ─────────────────────────── Required ───────────────────────────
# The server will not start without these.

# MongoDB connection string.
DB_URL="mongodb://localhost:27017/healwin"

# Redis — used for rate limiting and caching.
REDIS_URL="redis://localhost:6379"

# Signing key for admin/user JWTs. Use a long random string; rotating it logs
# everyone out.
JWTSECRET="change-me-to-a-long-random-string"

# AWS S3 — patient documents, candidate resumes, offer letters, selfies.
ACCESSKEY="AKIAXXXXXXXXXXXXXXXX"
SECRETACCESSKEY="your-aws-secret-access-key"
BUCKET="healwin-uploads"
REGION="ap-south-1"


# ─────────────────────────── Server ───────────────────────────

# The code falls back to 4000 if unset, but the admin panel and website are
# configured against 9050 — keep this unless you change them too.
PORT=9050
NODE_ENV="development"

# Comma-separated allowed origins for browser clients. "*" is fine locally and
# is NOT appropriate in production — list the real admin and website domains.
CORS_ORIGIN="*"

# Seconds before an outbound HTTP request to a third party is abandoned.
REQUEST_TIMEOUT=30

# JWT lifetimes.
JWT_EXPIRES_IN="30d"
JWT_ADMIN_EXPIRES_IN="1d"

# Mongo pool sizing. Leave DB_RETRY_WRITES false on a standalone server —
# standalone MongoDB rejects retryable writes. Set true on a replica set.
DB_POOL_SIZE=10
DB_MIN_POOL_SIZE=2
DB_RETRY_WRITES=false


# ─────────────────────────── OTP / auth ───────────────────────────

# Development shortcut: this OTP is accepted for any login. MUST be blank in
# production, or anyone who knows it can sign in as anybody.
# All OTPs in the system are 4 digits (see utils/helpers.ts OTP_LENGTH), so a
# master OTP has to be 4 digits too.
MASTER_OTP="1234"


# ─────────────────────────── Email (SMTP) ───────────────────────────
#
# SENDER_EMAIL + APP_PASSWORD are the account everything is sent from —
# careers acknowledgements, interview invitations, offer and appointment
# letters, OTP mail. For Gmail / Google Workspace, APP_PASSWORD is a 16-char
# App Password (Google Account → Security → App passwords), NOT the login
# password.
#
# Unlike SMS, these are genuinely used: getSmtpConfig() reads the SmtpSettings
# collection first and falls back to these values when no row exists — which is
# the normal state, so this is usually what actually sends your mail.
#
# The consequence: SMTP settings saved in the admin panel OVERRIDE this file
# entirely. If mail seems to ignore what is set here, clear that screen.

SENDER_EMAIL="you@yourdomain.com"
APP_PASSWORD="xxxx xxxx xxxx xxxx"

# The mail server itself. This is a HOSTNAME, not an email address — putting an
# address here fails with "getaddrinfo ENOTFOUND".
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false

# Legacy names for the same credentials, kept for older deployments.
# SENDER_EMAIL / APP_PASSWORD above take precedence when both are set.
SMTP_USER=""
SMTP_PASS=""

# Display identity on outgoing mail. If SMTP_FROM_EMAIL differs from
# SENDER_EMAIL, Gmail rewrites it to the authenticated account unless it is a
# verified "Send mail as" alias.
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Healwin HR"
SMTP_COMPANY_NAME="Healwin"

# Where HR copies of candidate mail go. SMTP_HR_EMAILS accepts a comma list.
SMTP_HR_EMAIL="hr@yourdomain.com"
SMTP_HR_EMAILS=""
SMTP_ACK_CC_EMAILS=""

# Optional separate mailbox for OTP mail. Falls back to the settings above.
SMTP_OTP_HOST=""
SMTP_OTP_PORT=""
SMTP_OTP_SECURE=""
SMTP_OTP_USER=""
SMTP_OTP_PASS=""
SMTP_OTP_FROM_EMAIL=""
SMTP_OTP_FROM_NAME="Healwin OTP"


# ─────────────────────────── Telephony (MyOperator) ───────────────────────────
#
# MyOperator runs both the IVR and click-to-call. Credentials come from the
# MyOperator dashboard (Manage → API integration).

MYOPERATOR_API_KEY=""
MYOPERATOR_COMPANY_ID=""
MYOPERATOR_SECRET_TOKEN=""
MYOPERATOR_API_URL="https://obd-api.myoperator.co/obd-api-v1"

# The OBD call type for a live agent-to-customer bridge. MyOperator does not
# publish this value and it varies by account — if calls are placed but never
# bridge, this is the first thing to check.
MYOPERATOR_CALL_TYPE="peer_to_peer"

# Shared secret protecting the inbound webhook. The endpoint must be public
# (MyOperator cannot hold a session), so this token is what guards it. Put the
# same value in the callback URL configured at MyOperator:
#   https://your-domain/api/v1/webhooks/myoperator?token=THIS_VALUE
# Leave blank ONLY in development — blank disables the check entirely.
MYOPERATOR_WEBHOOK_TOKEN=""

# Control-room number rung for click-to-call when the admin placing the call
# has no mobile number on their own profile. Ten digits, no +91.
IVR_OPERATOR_NUMBER=""


# ─────────────────────────── Maps ───────────────────────────

# SERVER-side Google key: needs Geocoding, Places and Distance Matrix enabled,
# and must NOT be restricted to Android/iOS apps. Pickup and drop address
# search fails silently if this is an app-restricted key.
GOOGLE_MAPS_API_KEY=""


# ─────────────────────────── Push notifications ───────────────────────────

# Firebase service account for FCM. Provide ONE of these: a path to the JSON
# file, or the whole JSON inline (useful on hosts with no writable filesystem).
FIREBASE_CREDENTIALS_PATH="./firebase-service-account.json"
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_SERVICE_ACCOUNT=""

# Apple Push (iOS), if the apps ship on iOS.
APN_KEY_ID=""
APN_TEAM_ID=""


# ───────────────────── Document letterhead (brand) ─────────────────────
#
# Printed on every generated PDF — offer and appointment letters, invoices,
# receipts, prescriptions, discharge summaries, payslips and the application
# acknowledgement. Leave a value blank and it is simply left off the page.
#
# The older HOSPITAL_* names still work as fallbacks for each of these.

BRAND_NAME="HealWin"
BRAND_TAGLINE="Emergency & Critical Care"
BRAND_EMAIL="care@healwin.in"
BRAND_PHONE=""
BRAND_WEBSITE=""
BRAND_ADDRESS=""
# Optional logo shown at the left of the letterhead. Absolute URL; a fetch
# failure is ignored rather than breaking the document.
BRAND_LOGO_URL=""

# Preview all documents with sample data:  npm run preview:documents /tmp/docs


# ─────────────────────────── Payments ───────────────────────────
#
# Razorpay is LIVE. The gateway keys normally live in the database, entered
# under Admin → System → Payment Configuration, where they are encrypted at
# rest and can be rotated without a redeploy.
#
# The variables below are only a fallback for when nothing is configured in
# the panel (a fresh install, or a scripted deployment). Anything saved in the
# panel takes precedence over them.

RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set the same value on the webhook in the Razorpay dashboard.
# Webhook URL:  https://<your-domain>/v1/api/webhooks/razorpay
# Events:       payment.captured, payment.failed
RAZORPAY_WEBHOOK_SECRET=""
PAYMENT_WEBHOOK_SECRET=""

# Key used to encrypt gateway credentials before they are written to the
# database (AES-256-GCM). Generate with:  openssl rand -hex 32
# If unset, JWTSECRET is used — which means CHANGING JWTSECRET WOULD MAKE
# ALREADY-SAVED CREDENTIALS UNREADABLE, so set this explicitly in production.
CONFIG_ENCRYPTION_KEY=""


# ─────────────────────────── Realtime (MQTT) ───────────────────────────
# Live ambulance location streaming.

MQTT_URL=""
MQTT_USERNAME=""
MQTT_PASSWORD=""


# ─────────────────────────── SMS — nothing to set here ───────────────────────
#
# SMS has NO environment variables. sms.service.ts reads its provider, API key,
# sender ID and template IDs from the SmsSettings collection, and refuses to
# send when that row is missing ("SMS service not configured") — it never falls
# back to the environment.
#
# Configure SMS in the admin panel instead.
#
# (config/index.ts still declares SMS_PROVIDER and TWILIO_* under `config.sms`,
# but nothing reads `config.sms` — those are dead and setting them does
# nothing. Contrast with the mail section above, where the env values ARE used
# whenever no SMTP row exists in the database.)


# ─────────────────────────── Hospital identity ───────────────────────────
# Printed on invoices, prescriptions, discharge summaries and payslips.

HOSPITAL_NAME="HealWin Life Support & Emergency Care"
HOSPITAL_ADDRESS=""
HOSPITAL_PHONE=""
HOSPITAL_EMAIL=""
HOSPITAL_WEBSITE=""
HOSPITAL_GSTIN=""

# Support contact surfaced to the patient app's Call/Email buttons.
# These three are lowercase on purpose — that is how the code reads them.
support_phone=""
support_email=""
call_helpline_number=""


# ─────────────────────────── Fares & dispatch ───────────────────────────
# Defaults only — live fares come from admin Types & Pricing (VehicleType).

DEFAULT_BASE_FARE=50
DEFAULT_PER_KM_RATE=15
DEFAULT_PER_MINUTE_RATE=2
DEFAULT_CANCELLATION_CHARGE=50
FREE_WAITING_MINUTES=5
WAITING_CHARGE_PER_MINUTE=2
GST_PERCENTAGE=5

# Ambulance search: how far to look, and how far to widen each round.
INITIAL_SEARCH_RADIUS_KM=5
RADIUS_INCREMENT_KM=3
MAX_SEARCH_RADIUS_KM=15
MAX_DRIVERS_TO_NOTIFY=10
BOOKING_REQUEST_TIMEOUT=30

# Surge pricing.
SURGE_THRESHOLD=0.8
MAX_SURGE_MULTIPLIER=2

# Crew payouts.
DRIVER_BASE_PER_TRIP=0
DRIVER_PER_KM=0
ATTENDANT_SHARE_PCT=0


# ─────────────────────────── OPD scheduling ───────────────────────────

CLINIC_START_HOUR=9
CLINIC_END_HOUR=17
CLINIC_SLOT_MINUTES=15


# ─────────────────────────── Coins & rewards ───────────────────────────

COIN_EARN_RATE=1
COIN_CONVERSION_RATE=1
COIN_MAX_DISCOUNT_PERCENT=20
COIN_EXPIRY_DAYS=365
COIN_MIN_WALLET_TRANSFER=100
COIN_MIN_BANK_TRANSFER=500


# ─────────────────────────── Seeding (local only) ───────────────────────────
# Used by the npm run seed:* scripts. SEED_RESET=true WIPES seeded collections
# before re-seeding — never set it on a live database.

SEED_RESET=false
SEED_ADMIN_EMAIL=""
SEED_ADMIN_ID=""
SEED_STATE_ID=""
SEED_DISTRICT_ID=""
